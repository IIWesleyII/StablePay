# Copy this file to .env and replace the placeholder values.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/stablepay
MERCHANT_WALLET_ADDRESS=0x0000000000000000000000000000000000000000
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_SEPOLIA_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# Use a dedicated Base Sepolia address. StablePay only watches it in Module 4.
STABLEPAY_VAULT_ADDRESS=0x1111111111111111111111111111111111111111
VAULT_CHALLENGE_EXPIRATION_MINUTES=5
VAULT_DEPOSIT_EXPIRATION_MINUTES=15
SETTLEMENT_MINIMUM_AMOUNT=0.000001
SETTLEMENT_CONFIRMATION_BATCH_SIZE=20
# Local payout command only; never commit STABLEPAY_VAULT_PRIVATE_KEY.
PAYMENT_EXPIRATION_MINUTES=15
PAYMENT_EXPIRATION_POLL_SECONDS=30
PAYMENT_REQUIRED_CONFIRMATIONS=3
BLOCKCHAIN_MONITOR_ENABLED=true
BLOCKCHAIN_MONITOR_POLL_SECONDS=5
BLOCKCHAIN_MONITOR_BLOCK_BATCH_SIZE=10
BLOCKCHAIN_MONITOR_INITIAL_LOOKBACK_BLOCKS=1000
BLOCKCHAIN_MONITOR_CONFIRMATION_BATCH_SIZE=100
MERCHANT_WEBHOOK_URL=http://127.0.0.1:9000/webhooks/stablepay
MERCHANT_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
WEBHOOK_DELIVERY_POLL_SECONDS=2
WEBHOOK_DELIVERY_TIMEOUT_SECONDS=10
WEBHOOK_DELIVERY_BATCH_SIZE=20
WEBHOOK_DELIVERY_LEASE_SECONDS=30
WEBHOOK_DELIVERY_MAX_ATTEMPTS=5
WEBHOOK_DELIVERY_RETRY_SECONDS=5
